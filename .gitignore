# Rust
/target/
**/*.rs.bk
Cargo.lock.bootstrap

# Native build output and generated bindings
**/bindings.rs
**/*.o
**/*.a
**/*.so
**/*.dylib
**/*.dll

# Test and coverage artifacts
/artifacts/
/coverage/
*.profraw
*.profdata
lcov.info

# Local secrets and environment
.env
.env.*
!.env.example
secrets/
*.secret
*.pem
*.key

# Docker and Compose local overrides
compose.override.yaml
deploy/compose.override.yaml

# Editors and operating systems
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Python helpers
__pycache__/
*.py[cod]
.pytest_cache/

# Temporary files
*.tmp
*.log

# Personal Claude Code settings (not team-shared)
.claude/settings.local.json
