#!/usr/bin/env bash
set -euo pipefail

export DISPLAY="${DISPLAY:-:1}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp/runtime-$(id -u)}"
install -d -m 0700 "$XDG_RUNTIME_DIR"

# Expansion is intentionally deferred to the inner Bash process.
# shellcheck disable=SC2016
exec dbus-launch --exit-with-session bash -euo pipefail -c '
    xfconf-query -c xfce4-session -p /general/SaveOnExit -n -t bool -s false >/dev/null 2>&1 || true
    startxfce4 >/tmp/xfce-session.log 2>&1 &
    xfce_pid=$!
    trap "kill -TERM ${xfce_pid} 2>/dev/null || true" EXIT TERM INT
    for _ in $(seq 1 100); do
        if xfconf-query -c xfce4-session -p /general/SaveOnExit >/dev/null 2>&1; then
            break
        fi
        kill -0 "${xfce_pid}" 2>/dev/null || exit 1
        sleep 0.1
    done
    exec python3 /opt/vnc-test-app/test_app.py
'
